<!--
  Arestas (troços de via) da rede.
  Av. Eduardo Mondlane (E-W): 2 faixas por sentido, via primária, 50 km/h.
  Av. Salvador Allende (N-S): 1 faixa por sentido, via secundária, 40 km/h.
  Nomes reais mantidos para rastreabilidade com o Capítulo III do PFC.
-->
<edges>
    <!-- Av. Eduardo Mondlane, sentido Oeste -> Centro -> Este -->
    <edge id="EM_W_in"  from="W" to="C" numLanes="2" speed="13.9" name="Av. Eduardo Mondlane"/>
    <edge id="EM_C_out" from="C" to="E" numLanes="2" speed="13.9" name="Av. Eduardo Mondlane"/>
    <edge id="EM_E_in"  from="E" to="C" numLanes="2" speed="13.9" name="Av. Eduardo Mondlane"/>
    <edge id="EM_C_out2" from="C" to="W" numLanes="2" speed="13.9" name="Av. Eduardo Mondlane"/>

    <!-- Av. Salvador Allende, sentido Norte -> Centro -> Sul -->
    <edge id="SA_N_in"  from="N" to="C" numLanes="1" speed="11.1" name="Av. Salvador Allende"/>
    <edge id="SA_C_out" from="C" to="S" numLanes="1" speed="11.1" name="Av. Salvador Allende"/>
    <edge id="SA_S_in"  from="S" to="C" numLanes="1" speed="11.1" name="Av. Salvador Allende"/>
    <edge id="SA_C_out2" from="C" to="N" numLanes="1" speed="11.1" name="Av. Salvador Allende"/>
</edges>
