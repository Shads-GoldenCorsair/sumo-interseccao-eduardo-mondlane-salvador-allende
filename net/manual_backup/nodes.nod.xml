<!--
  Nós da rede: intersecção Av. Eduardo Mondlane x Av. Salvador Allende, Maputo.
  Geometria baseada na confirmação visual feita via OpenStreetMap (consulta manual,
  Julho de 2026) e na descrição da Wikipédia (PT): intersecção ortogonal de 4 braços,
  Av. Eduardo Mondlane com 4 a 6 faixas, Av. Salvador Allende mais estreita.
  Coordenadas em metros, sistema local (não georreferenciado), centro da intersecção na origem.
-->
<nodes>
    <!-- Nó central: a intersecção controlada por semáforo -->
    <node id="C" x="0.0" y="0.0" type="traffic_light"/>

    <!-- Aproximações: Eduardo Mondlane corre Este-Oeste; Salvador Allende corre Norte-Sul -->
    <node id="N" x="0.0" y="300.0" type="priority"/>   <!-- Salvador Allende, extremo Norte -->
    <node id="S" x="0.0" y="-300.0" type="priority"/>  <!-- Salvador Allende, extremo Sul -->
    <node id="E" x="350.0" y="0.0" type="priority"/>   <!-- Eduardo Mondlane, extremo Este -->
    <node id="W" x="-350.0" y="0.0" type="priority"/>  <!-- Eduardo Mondlane, extremo Oeste -->
</nodes>
