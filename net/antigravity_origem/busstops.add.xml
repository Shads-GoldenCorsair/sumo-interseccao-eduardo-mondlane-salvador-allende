<?xml version="1.0" encoding="UTF-8"?>
<!--
    Paragens de Machimbombo (Autocarro) [BUS]
    Conforme as marcações a verde no diagrama do utilizador:
    1. Paragem no bordo Norte da faixa lateral Este (Eduardo Mondlane sentido Este) - logo a seguir à passadeira
    2. Paragem no bordo Sul da faixa lateral Oeste (Eduardo Mondlane sentido Oeste) - logo a seguir à passadeira
-->
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">

    <!-- Paragem de Autocarro Norte-Este (Sentido Este) -->
    <busStop id="busStop_EduardoMondlane_NorteEste"
             lane="mondlane_EN_lat_bus_1"
             startPos="2.0"
             endPos="18.0"
             lines="101 102 103 Machimbombo_TPM"
             friendlyPos="true">
    </busStop>

    <!-- Paragem de Autocarro Sul-Oeste (Sentido Oeste) -->
    <busStop id="busStop_EduardoMondlane_SulOeste"
             lane="mondlane_WS_lat_bus_1"
             startPos="2.0"
             endPos="18.0"
             lines="201 202 203 Machimbombo_TPM"
             friendlyPos="true">
    </busStop>
    <!-- ==================================================================== -->
    <!-- LINHA DIVISÓRIA CONTÍNUA (M2) ENTRE SENTIDOS OPOSTOS DE MONDLANE     -->
    <!-- ==================================================================== -->
    <!-- Lado Oeste: divide Pista Norte (Este) e Pista Sul (Oeste) até à passadeira -->
    <poly id="linha_continua_sentidos_opostos_W"
          shape="0.0,70.0 88.5,70.0"
          color="white"
          lineWidth="0.22"
          fill="false"
          layer="100"/>

    <!-- Lado Este: divide Pista Norte (Este) e Pista Sul (Oeste) após a passadeira -->
    <poly id="linha_continua_sentidos_opostos_E"
          shape="100.4,70.0 180.0,70.0"
          color="white"
          lineWidth="0.22"
          fill="false"
          layer="100"/>

</additional>
