<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cenário de PROCURA ELEVADA (hora de pico), simulando os intervalos
  05h00-09h00 e 15h00-19h00 documentados no Capítulo III, secção 3.1.6.2.

  IMPORTANTE: os volumes (vehsPerHour) e a distribuição percentual entre movimentos
  de viragem são ESTIMATIVAS DE ENGENHARIA baseadas em padrões típicos de intersecções
  urbanas de elevado volume, e NÃO em contagens de campo reais, que ainda não foram
  realizadas (ver Capítulo III, secção 3.1.5, Desafios e Limitações do Caso de Estudo).
  Estes valores devem ser recalibrados assim que os dados de campo estiverem disponíveis.

  Simulação de 1 hora (3600 s). Duração total do período de pico real: 4 horas.

  Rotas actualizadas para a rede real (ver PROGRESSO.md, Fase 0): a interseccao
  tem 3 aproximacoes, não 4. Os volumes que antes eram das aproximações Norte e
  Sul de Salvador Allende (agora uma única aproximação real, SA_in) foram somados.
  O volume que antes era "W_right" foi dobrado sobre "EM1_straight", porque essa
  viragem à direita não existe fisicamente nesta interseccao real. O volume que
  era "EM2_uturn" foi dobrado sobre "EM2_straight", porque a viragem em U entre
  os dois ramos de Eduardo Mondlane não é fisicamente possível (confirmado por
  imagem de satélite, ver PROGRESSO.md).
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <vType id="ligeiro" vClass="passenger" length="4.5" maxSpeed="16.7" accel="2.6" decel="4.5" sigma="0.5" color="0.6,0.6,0.6"/>
    <vType id="chapa"   vClass="taxi"      length="5.5" maxSpeed="14.0" accel="2.0" decel="4.0" sigma="0.6" color="0.9,0.7,0.1"/>
    <vType id="autocarro" vClass="bus"     length="10.0" maxSpeed="12.0" accel="1.2" decel="3.5" sigma="0.4" color="0.1,0.5,0.2"/>
    <vType id="pesado"  vClass="truck"     length="8.0" maxSpeed="12.0" accel="1.3" decel="3.5" sigma="0.5" color="0.3,0.3,0.3"/>

    <!-- Perfis de peoes com ritmo de marcha diferenciado, coerente com o
         perfil de utilizacao heterogeneo da zona (hospital, faculdade de
         medicina, jardim infantil, CLAUDE.md seccao 1). Inspirado na rede
         de referencia em antigravity sumo/mondlane_allende.rou.xml. -->
    <vType id="ped_idoso"     vClass="pedestrian" width="0.45" length="0.40" maxSpeed="0.95" color="0.50,0.45,0.40"/>
    <vType id="ped_trabalho"  vClass="pedestrian" width="0.45" length="0.40" maxSpeed="1.34" color="0.15,0.40,0.80"/>
    <vType id="ped_estudante" vClass="pedestrian" width="0.40" length="0.35" maxSpeed="1.45" color="0.95,0.95,0.98"/>
    <vType id="ped_vendedora" vClass="pedestrian" width="0.48" length="0.45" maxSpeed="1.15" color="0.95,0.70,0.10"/>

    <route id="EM1_straight" edges="552827135#0 552827132"/>
    <route id="EM1_left"     edges="552827135#0 24769111#11"/>
    <route id="EM2_straight" edges="725127419#1 725127419#3a 725127419#3b 725127419#3c"/>
    <route id="EM2_right"    edges="725127419#1 24769111#11"/>
    <!-- Rota so para autocarros: para na paragem real "Ministerio da Saude"
         (net/paragens.add.xml), logo apos o cruzamento, confirmada pelo
         autor. Tempo de paragem tipico para embarque/desembarque. -->
    <route id="EM2_straight_com_paragem" edges="725127419#1 725127419#3a 725127419#3b 725127419#3c">
        <!-- parking="true": o autocarro para, mas o transito atras consegue
             ultrapassa-lo, em vez de ficar bloqueado na faixa (efeito
             pratico de uma baia de autocarro fisica, ver PROGRESSO.md). -->
        <stop busStop="paragem_ministerio_saude" duration="20" parking="true"/>
    </route>
    <route id="SA_straight" edges="24769111#9 24769111#11"/>
    <route id="SA_right"    edges="24769111#9 552827132"/>
    <route id="SA_left"     edges="24769111#9 725127419#3a 725127419#3b 725127419#3c"/>

    <!-- Eduardo Mondlane, ramo 1: fluxo dominante (via primária) -->
    <flow id="f_EM1_straight_lig" type="ligeiro"   route="EM1_straight" begin="0" end="3600" vehsPerHour="515" departLane="best"/>
    <flow id="f_EM1_straight_cha" type="chapa"     route="EM1_straight" begin="0" end="3600" vehsPerHour="110" departLane="best"/>
    <flow id="f_EM1_straight_bus" type="autocarro" route="EM1_straight" begin="0" end="3600" vehsPerHour="18"  departLane="best"/>
    <flow id="f_EM1_pesado"       type="pesado"    route="EM1_straight" begin="0" end="3600" vehsPerHour="25"  departLane="best"/>
    <flow id="f_EM1_left_lig"     type="ligeiro"   route="EM1_left"     begin="0" end="3600" vehsPerHour="70"  departLane="best"/>

    <!-- Eduardo Mondlane, ramo 2 -->
    <flow id="f_EM2_straight_lig" type="ligeiro"   route="EM2_straight" begin="0" end="3600" vehsPerHour="455" departLane="best"/>
    <flow id="f_EM2_straight_cha" type="chapa"     route="EM2_straight" begin="0" end="3600" vehsPerHour="105" departLane="best"/>
    <flow id="f_EM2_straight_bus" type="autocarro" route="EM2_straight_com_paragem" begin="0" end="3600" vehsPerHour="16"  departLane="best"/>
    <flow id="f_EM2_pesado"       type="pesado"    route="EM2_straight" begin="0" end="3600" vehsPerHour="20"  departLane="best"/>
    <flow id="f_EM2_right_lig"    type="ligeiro"   route="EM2_right"    begin="0" end="3600" vehsPerHour="80"  departLane="best"/>

    <!-- Salvador Allende: fluxo secundário, mas relevante (hospital, faculdade) -->
    <flow id="f_SA_straight_lig" type="ligeiro" route="SA_straight" begin="0" end="3600" vehsPerHour="350" departLane="best"/>
    <flow id="f_SA_straight_cha" type="chapa"   route="SA_straight" begin="0" end="3600" vehsPerHour="105" departLane="best"/>
    <flow id="f_SA_right_lig"    type="ligeiro" route="SA_right"    begin="0" end="3600" vehsPerHour="115" departLane="best"/>
    <flow id="f_SA_left_lig"     type="ligeiro" route="SA_left"     begin="0" end="3600" vehsPerHour="85"  departLane="best"/>

    <!-- Fluxo de peoes REMOVIDO nesta sessao: sem passeio dedicado em
         Eduardo Mondlane (correccao do autor, ver PROGRESSO.md), o SUMO
         faz o peao andar ao LONGO da faixa partilhada (77-125s por
         travessia, nao um atravessamento rapido), o que causou uma
         colisao real com um veiculo num teste. Os perfis de peao
         (ped_idoso etc.) ficam definidos para reutilizar quando houver
         uma solucao de travessia segura (precisa de infra-estrutura
         minima de passadeira, nao so foot=yes). Ver PROGRESSO.md.-->

</routes>
