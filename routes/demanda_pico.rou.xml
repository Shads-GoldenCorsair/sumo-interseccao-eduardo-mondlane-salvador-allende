<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cenário de PROCURA ELEVADA (hora de pico), simulando os intervalos
  05h00-09h00 e 15h00-19h00 documentados no Capítulo III, secção 3.1.6.2.

  IMPORTANTE: os volumes (vehsPerHour) e a distribuição percentual entre movimentos
  de viragem são ESTIMATIVAS DE ENGENHARIA baseadas em padrões típicos de intersecções
  urbanas de elevado volume, e NÃO em contagens de campo reais, que ainda não foram
  realizadas (ver Capítulo III, secção 3.1.5, Desafios e Limitações do Caso de Estudo).
  Estes valores devem ser recalibrados assim que os dados de campo estiverem disponíveis.

  Simulação de 1 hora (3600 s). Duração total do período de pico real: 4 horas.
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <vType id="ligeiro" vClass="passenger" length="4.5" maxSpeed="16.7" accel="2.6" decel="4.5" sigma="0.5" color="0.6,0.6,0.6"/>
    <vType id="chapa"   vClass="taxi"      length="5.5" maxSpeed="14.0" accel="2.0" decel="4.0" sigma="0.6" color="0.9,0.7,0.1"/>
    <vType id="autocarro" vClass="bus"     length="10.0" maxSpeed="12.0" accel="1.2" decel="3.5" sigma="0.4" color="0.1,0.5,0.2"/>
    <vType id="pesado"  vClass="truck"     length="8.0" maxSpeed="12.0" accel="1.3" decel="3.5" sigma="0.5" color="0.3,0.3,0.3"/>

    <route id="W_straight" edges="EM_W_in EM_C_out"/>
    <route id="W_right"    edges="EM_W_in SA_C_out"/>
    <route id="W_left"     edges="EM_W_in SA_C_out2"/>
    <route id="E_straight" edges="EM_E_in EM_C_out2"/>
    <route id="E_right"    edges="EM_E_in SA_C_out2"/>
    <route id="E_left"     edges="EM_E_in SA_C_out"/>
    <route id="N_straight" edges="SA_N_in SA_C_out"/>
    <route id="N_right"    edges="SA_N_in EM_C_out"/>
    <route id="N_left"     edges="SA_N_in EM_C_out2"/>
    <route id="S_straight" edges="SA_S_in SA_C_out2"/>
    <route id="S_right"    edges="SA_S_in EM_C_out2"/>
    <route id="S_left"     edges="SA_S_in EM_C_out"/>

    <!-- Eduardo Mondlane, sentido Oeste->Este: fluxo dominante (via primária) -->
    <flow id="f_W_straight_lig" type="ligeiro"   route="W_straight" begin="0" end="3600" vehsPerHour="420" departLane="best"/>
    <flow id="f_W_straight_cha" type="chapa"     route="W_straight" begin="0" end="3600" vehsPerHour="110" departLane="best"/>
    <flow id="f_W_straight_bus" type="autocarro" route="W_straight" begin="0" end="3600" vehsPerHour="18"  departLane="best"/>
    <flow id="f_W_right_lig"    type="ligeiro"   route="W_right"    begin="0" end="3600" vehsPerHour="95"  departLane="best"/>
    <flow id="f_W_left_lig"     type="ligeiro"   route="W_left"     begin="0" end="3600" vehsPerHour="70"  departLane="best"/>
    <flow id="f_W_pesado"       type="pesado"    route="W_straight" begin="0" end="3600" vehsPerHour="25"  departLane="best"/>

    <!-- Eduardo Mondlane, sentido Este->Oeste -->
    <flow id="f_E_straight_lig" type="ligeiro"   route="E_straight" begin="0" end="3600" vehsPerHour="390" departLane="best"/>
    <flow id="f_E_straight_cha" type="chapa"     route="E_straight" begin="0" end="3600" vehsPerHour="105" departLane="best"/>
    <flow id="f_E_straight_bus" type="autocarro" route="E_straight" begin="0" end="3600" vehsPerHour="16"  departLane="best"/>
    <flow id="f_E_right_lig"    type="ligeiro"   route="E_right"    begin="0" end="3600" vehsPerHour="80"  departLane="best"/>
    <flow id="f_E_left_lig"     type="ligeiro"   route="E_left"     begin="0" end="3600" vehsPerHour="65"  departLane="best"/>
    <flow id="f_E_pesado"       type="pesado"    route="E_straight" begin="0" end="3600" vehsPerHour="20"  departLane="best"/>

    <!-- Salvador Allende, sentido Norte->Sul: fluxo secundário, mas relevante (hospital, faculdade) -->
    <flow id="f_N_straight_lig" type="ligeiro"   route="N_straight" begin="0" end="3600" vehsPerHour="180" departLane="best"/>
    <flow id="f_N_straight_cha" type="chapa"     route="N_straight" begin="0" end="3600" vehsPerHour="55"  departLane="best"/>
    <flow id="f_N_right_lig"    type="ligeiro"   route="N_right"    begin="0" end="3600" vehsPerHour="60"  departLane="best"/>
    <flow id="f_N_left_lig"     type="ligeiro"   route="N_left"     begin="0" end="3600" vehsPerHour="45"  departLane="best"/>

    <!-- Salvador Allende, sentido Sul->Norte -->
    <flow id="f_S_straight_lig" type="ligeiro"   route="S_straight" begin="0" end="3600" vehsPerHour="170" departLane="best"/>
    <flow id="f_S_straight_cha" type="chapa"     route="S_straight" begin="0" end="3600" vehsPerHour="50"  departLane="best"/>
    <flow id="f_S_right_lig"    type="ligeiro"   route="S_right"    begin="0" end="3600" vehsPerHour="55"  departLane="best"/>
    <flow id="f_S_left_lig"     type="ligeiro"   route="S_left"     begin="0" end="3600" vehsPerHour="40"  departLane="best"/>

</routes>
