<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cenário de PROCURA REDUZIDA (baixo fluxo), simulando o intervalo
  21h00-05h00 documentado no Capítulo III, secção 3.1.6.2.

  Mesma ressalva do cenário de pico quanto à natureza estimada dos volumes.
  Simulação de 1 hora (3600 s), representativa do período nocturno.

  Rotas actualizadas para a rede real (ver PROGRESSO.md, Fase 0), mesma
  lógica de mapeamento usada em demanda_pico.rou.xml (inclui a fusão do
  volume "EM2_uturn" em "EM2_straight", a viragem em U não é fisicamente
  possível nesta interseccao real).
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <vType id="ligeiro" vClass="passenger" length="4.5" maxSpeed="16.7" accel="2.6" decel="4.5" sigma="0.5" color="0.6,0.6,0.6"/>
    <vType id="chapa"   vClass="taxi"      length="5.5" maxSpeed="14.0" accel="2.0" decel="4.0" sigma="0.6" color="0.9,0.7,0.1"/>
    <vType id="autocarro" vClass="bus"     length="10.0" maxSpeed="12.0" accel="1.2" decel="3.5" sigma="0.4" color="0.1,0.5,0.2"/>
    <vType id="pesado"  vClass="truck"     length="8.0" maxSpeed="12.0" accel="1.3" decel="3.5" sigma="0.5" color="0.3,0.3,0.3"/>

    <!-- Perfis de peoes, ver demanda_pico.rou.xml para a explicacao. Volume
         nocturno reduzido, so 2 perfis. -->
    <vType id="ped_idoso"    vClass="pedestrian" width="0.45" length="0.40" maxSpeed="0.95" color="0.50,0.45,0.40"/>
    <vType id="ped_trabalho" vClass="pedestrian" width="0.45" length="0.40" maxSpeed="1.34" color="0.15,0.40,0.80"/>

    <route id="EM1_straight" edges="552827135#0 552827132"/>
    <route id="EM1_left"     edges="552827135#0 24769111#11"/>
    <route id="EM2_straight" edges="725127419#1 725127419#3a 725127419#3b 725127419#3c"/>
    <route id="EM2_right"    edges="725127419#1 24769111#11"/>
    <route id="SA_straight" edges="24769111#9 24769111#11"/>
    <route id="SA_right"    edges="24769111#9 552827132"/>
    <route id="SA_left"     edges="24769111#9 725127419#3a 725127419#3b 725127419#3c"/>

    <flow id="f_EM1_straight_lig" type="ligeiro" route="EM1_straight" begin="0" end="3600" vehsPerHour="72" departLane="best"/>
    <flow id="f_EM1_straight_cha" type="chapa"   route="EM1_straight" begin="0" end="3600" vehsPerHour="8"  departLane="best"/>
    <flow id="f_EM1_left_lig"     type="ligeiro" route="EM1_left"     begin="0" end="3600" vehsPerHour="8"  departLane="best"/>

    <flow id="f_EM2_straight_lig" type="ligeiro" route="EM2_straight" begin="0" end="3600" vehsPerHour="62" departLane="best"/>
    <flow id="f_EM2_straight_cha" type="chapa"   route="EM2_straight" begin="0" end="3600" vehsPerHour="7"  departLane="best"/>
    <flow id="f_EM2_right_lig"    type="ligeiro" route="EM2_right"    begin="0" end="3600" vehsPerHour="10" departLane="best"/>

    <flow id="f_SA_straight_lig" type="ligeiro" route="SA_straight" begin="0" end="3600" vehsPerHour="38" departLane="best"/>
    <flow id="f_SA_right_lig"    type="ligeiro" route="SA_right"    begin="0" end="3600" vehsPerHour="11" departLane="best"/>
    <flow id="f_SA_left_lig"     type="ligeiro" route="SA_left"     begin="0" end="3600" vehsPerHour="9"  departLane="best"/>

    <!-- Peoes a atravessar Eduardo Mondlane, ver demanda_pico.rou.xml para
         a explicacao. Volume nocturno reduzido. -->
    <!-- Fluxo de peoes removido, ver demanda_pico.rou.xml (colisao real
         detectada, sem passeio a travessia partilha a faixa demasiado
         tempo). -->

</routes>
