<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tipos de veículos calibrados para o contexto de Maputo:
  - Ligeiros (carros particulares): a maioria do tráfego
  - Chapas (mini-autocarros de transporte colectivo, muito comuns em Moçambique)
  - Autocarros (transporte público formal, menos frequente)
  - Pesados (camiões e carrinhas de mercadorias)
-->
<additional>
    <vType id="ligeiro" vClass="passenger" length="4.5" maxSpeed="16.7" accel="2.6" decel="4.5" sigma="0.5" color="0.6,0.6,0.6"/>
    <vType id="chapa"   vClass="taxi"      length="5.5" maxSpeed="14.0" accel="2.0" decel="4.0" sigma="0.6" color="0.9,0.7,0.1"/>
    <vType id="autocarro" vClass="bus"     length="10.0" maxSpeed="12.0" accel="1.2" decel="3.5" sigma="0.4" color="0.1,0.5,0.2"/>
    <vType id="pesado"  vClass="truck"     length="8.0" maxSpeed="12.0" accel="1.3" decel="3.5" sigma="0.5" color="0.3,0.3,0.3"/>
</additional>
