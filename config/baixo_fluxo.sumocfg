<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../net/eduardo_mondlane_salvador_allende.net.xml"/>
        <route-files value="../routes/demanda_baixo_fluxo.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="300"/>
        <collision.action value="warn"/>
    </processing>
    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>
    <output>
        <summary-output value="../outputs/resumo_baixo_fluxo.xml"/>
        <tripinfo-output value="../outputs/tripinfo_baixo_fluxo.xml"/>
        <queue-output value="../outputs/filas_baixo_fluxo.xml"/>
    </output>
</configuration>
